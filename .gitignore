__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env
.env.local

.vscode/
.idea/
.DS_Store

# LLM output caches (regenerable from source + prompt)
.cache/
drafts/raw/
state/

# Copyrighted Bible text used only under an explicit private license. Reports
# may commit aggregate scores; source wording must never enter git history.
state/licensed_references/
*.licensed-bible.json

# Per-page transcription backups from apply_transcription_reviews.py.
# Restorable by `mv <f>.bak <f>`; not committed to avoid ~2x storage bloat.
sources/lxx/swete/transcribed/*.txt.bak

# Claude Opus review artifacts from the superseded Opus cross-read run.
# The parseable subset was folded into the Azure pass; the rest were
# limit/stop messages and are not worth tracking.
sources/lxx/swete/transcribed/*.opus-review.json

# Reviewer private keys must never be committed
*.key
*_private.pem

# Local tool configuration
.tool_config.local.json
.claude/
.DS_Store

# Per-clone Claude Code project guide; not part of the public repo
CLAUDE.md

# 2 Esdras source PDFs — tracked via sources/2esdras/MANIFEST.md with SHA-256 hashes
# (following the Swete precedent; rehydrate from archive.org if missing)
sources/2esdras/scans/*.pdf
sources/2esdras/latin/*.pdf

# 2 Baruch source files — tracked via sources/2baruch/MANIFEST.md
sources/2baruch/scans/*.pdf
sources/2baruch/scans/*.zip
sources/2baruch/scans/*.djvu
sources/2baruch/reference/*.pdf

# 1 Enoch source PDFs — tracked via sources/enoch/MANIFEST.md
sources/enoch/scans/*.pdf
# Jubilees source PDFs — tracked via sources/jubilees/MANIFEST.md
sources/jubilees/scans/*.pdf

# Group A Greek extra-canonical source PDFs — tracked via per-text manifests
sources/didache/scans/*.pdf
sources/1_clement/scans/*.pdf
sources/shepherd_of_hermas/scans/*.pdf
sources/testaments_twelve_patriarchs/scans/*.pdf
# Nag Hammadi local staging / OCR output
sources/nag_hammadi/staging/*
!sources/nag_hammadi/staging/.gitkeep
!sources/nag_hammadi/staging/README.md
sources/nag_hammadi/ocr/output/*
!sources/nag_hammadi/ocr/output/.gitkeep
!sources/nag_hammadi/ocr/output/README.md
sources/lxx/prayer_of_manasseh/scans/*.pdf

# Spanish pipeline transient retry artifacts
translation_es/**/*.invalid-*
translation_es/**/*.lock
translation_es/**/*.review.lock
translation_ko/**/*.invalid-*
translation_simplified/**/*.invalid-*
translation_ko/**/*.lock
translation_ko/**/*.review.lock
# Full-resolution DSS source masters are rehydratable from the rights-gated
# registry and intentionally kept out of ordinary Git history.
sources/dead_sea_scrolls/images/masters/
sources/dead_sea_scrolls/pilots/*/raw/

# Ephemeral Pseudo-Clementine process locks, not review evidence
sources/early_christian_texts/**/.lock
sources/pseudo_clementines/**/.lock
