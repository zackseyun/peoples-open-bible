    "xml": "<ns0:verse xmlns:ns0=\"http://www.bibletechnologies.net/2003/OSIS/namespace\" osisID=\"1Chr.12.14\">\n          <ns0:note>KJV:1Chr.12.13</ns0:note>\n          <ns0:w lemma=\"3414\" n=\"0.1.0\" morph=\"HNp\" id=\"13MAJ\">יִרְמְיָ֨הוּ֙</ns0:w>\n          <ns0:w lemma=\"d/6224\" n=\"0.1\" morph=\"HTd/Aomsa\" id=\"13eFY\">הָ/עֲשִׂירִ֔י</ns0:w>\n          <ns0:seg type=\"x-samekh\">ס</ns0:seg>\n          <ns0:w lemma=\"4344\" n=\"0.0\" morph=\"HNp\" id=\"139CN\">מַכְבַּנַּ֖י</ns0:w>\n          <ns0:w lemma=\"6249\" morph=\"HAobpc\" id=\"133M5\">עַשְׁתֵּ֥י</ns0:w>\n          <ns0:w lemma=\"6240\" n=\"0\" morph=\"HAcmsa\" id=\"135Ar\">עָשָֽׂר</ns0:w><ns0:seg type=\"x-sof-pasuq\">׃</ns0:seg>\n        </ns0:verse>\n        ",
    "legacy_rendering": "יִרְמְיָ֨הוּ֙ הָ/עֲשִׂירִ֔י מַכְבַּנַּ֖י עַשְׁתֵּ֥י עָשָֽׂרס׃",
