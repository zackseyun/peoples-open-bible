[{"reference": "1 Enoch 22:1", "source": {"edition": "charles-1906-enoch", "text": "ወእምህየ፡ ሖርኩ፡ ካልአ፡ መካነ፡ ወአርአየኒ፡ በምዕራብ፡ *ደብረ፡ ዐቢየ፡ ወ*ነዋኅ፡ ወ*ኵኵሐ፡ ጽኑዐ።", "language": "Geez", "pages": [94], "confidence": "medium", "validation": "unapplied_full_printed_unit_candidate", "note": "Recovered from sources/enoch/ethiopic/transcribed/charles_1906/ch22.txt via tools/enoch/verse_parser.py | Dillmann 1851 chapter OCR exists for chapter 22, but verse-aligned extraction is not yet implemented in this prompt builder."}, "translation": {"text": "And from there I went to another place[a], and he showed me in the west a great and high mountain[b], and a hard rock.", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "The description may be read as a mountain that is both great and lofty; the Ge'ez preserves both qualities rather than reducing them to a single adjective.", "reason": "lexical_alternative"}, {"marker": "b", "text": "The final phrase can also be rendered 'solid rock' or 'firm rock.'", "reason": "lexical_alternative"}]}}, {"reference": "1 Enoch 22:2", "source": {"edition": "charles-1906-enoch", "text": "ወአርባዕቱ፡ መካናት፡ †ሠናያት፡ [ወ]በውስቴቱ፡ ዘቦቱ፡ *ዕሙቀ፡ ወርኂበ፡ ወልሙጸ፡ ጥቀ፡ (ሠለስቱ፡ እምኔሆን፡ ጸልማት፡ ወአሐቲ፡ ብርህት፡ ወነቅዐ፡ ማይ፡ በማእከላ፡ እቤ፡) ከመ፡ ልሙጽ፡ †ዘያንኩረኵር፡† ወዕሙቅ፡ ወጽልመት፡ ለነጽሮ።", "language": "Geez", "pages": [94], "confidence": "medium", "validation": "unapplied_full_printed_unit_candidate", "note": "Recovered from sources/enoch/ethiopic/transcribed/charles_1906/ch22.txt via tools/enoch/verse_parser.py | Dillmann 1851 chapter OCR exists for chapter 22, but verse-aligned extraction is not yet implemented in this prompt builder."}, "translation": {"text": "And there were four hollow places in it[a], deep and wide and very smooth; three of them were dark, and one was bright, and water was springing up in its midst. And I said, “How smooth these hollow places are[c][b], and deep and dark to look at.”", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "The Ethiopic text in this verse is difficult at several points, especially in the description of the hollows as 'smooth.' The sense is likely that the cavities were sheer or polished in appearance.", "reason": "lexical_alternative"}, {"marker": "b", "text": "Some interpreters understand the phrase about water as referring to a spring or stream located in the middle of the bright hollow.", "reason": "alternative_reading"}, {"marker": "c", "text": "Or 'deep and very smooth'.", "reason": "previous_rendering"}]}}, {"reference": "1 Enoch 22:3", "source": {"edition": "charles-1906-enoch", "text": "ውእቱ፡ ጊዜ፡ አውሥአ፡ ሩፋኤል፡ ፩*እምነ፡ ቅዱሳን፡ መላእክት፡ እግዚ፡ ሀለወ፡ ምስሌየ፡ ወይቤለኒ፡ ዝመካናት፡ †ሰናያት፡† ከመ፡ ይትጋብኡ፡ ዲቤሆን፡ *መናፍስት፡ ለነፍሶሙ፡ ለምዉታን፤ *ሎቱ፡ ዝንቱ፡ ተፈጥሩ፡ ዝየ፡ ያስተጋብኡ፡ ኵሎ፡ ነፍሰ፡ ውሉደ፡ ሰብእ።", "language": "Geez", "pages": [94], "confidence": "medium", "validation": "unapplied_full_printed_unit_candidate", "note": "Recovered from sources/enoch/ethiopic/transcribed/charles_1906/ch22.txt via tools/enoch/verse_parser.py | Dillmann 1851 chapter OCR exists for chapter 22, but verse-aligned extraction is not yet implemented in this prompt builder."}, "translation": {"text": "And at that time Raphael[a], one of the holy angels who was with me, answered and said to me, “These hollow places were made so that the spirits, the souls of the dead, might be gathered into them[c][b]. For this purpose they were created here: that they might gather all the souls of the children of men.”", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "Or 'good places' or 'fair places'; the adjective can denote moral goodness or pleasing beauty.", "reason": "lexical_alternative"}, {"marker": "b", "text": "The verse uses both 'spirits' and 'souls,' likely in apposition rather than as sharply distinct categories.", "reason": "lexical_alternative"}, {"marker": "c", "text": "Or 'These beautiful places'.", "reason": "previous_rendering"}]}}, {"reference": "1 Enoch 22:4", "source": {"edition": "charles-1906-enoch", "text": "ወእሙንቱ፡ መካናት፡ ኀበ፡ ይነብርዎሙ፡ †ገብሩ፡† እስከ፡ ዕለተ፡ ኵነኔሆሙ፡ ወእስከ፡ አመ፡ ዕድሜሆሙ፡ ወዕድሜ፡ [ውእቱ፡ ዘየዓቢ፡] *እስከ፡ አመ፡ ኵነኔ፡ ዐቢይ፡ በላዕሌሆሙ።", "language": "Geez", "pages": [94], "confidence": "medium", "validation": "unapplied_full_printed_unit_candidate", "note": "Recovered from sources/enoch/ethiopic/transcribed/charles_1906/ch22.txt via tools/enoch/verse_parser.py | Dillmann 1851 chapter OCR exists for chapter 22, but verse-aligned extraction is not yet implemented in this prompt builder."}, "translation": {"text": "And these places were made for them to dwell in until the day of their judgment[a], and until their appointed time, and that appointed time is long[c][b], until the time of the great judgment upon them.", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "The marked word in the Ethiopic witness (†ገብሩ†) is textually uncertain. The sense of the clause is that these are the places designated for them to dwell until judgment.", "reason": "textual_variant"}, {"marker": "b", "text": "'Appointed time' renders a term that can also mean 'age,' 'lifetime,' or 'term.' Here it likely refers to the fixed period allotted before final judgment.", "reason": "lexical_alternative"}, {"marker": "c", "text": "Or 'And these are the places where they will dwell until the day of their judgment, and until their appointed time, and that appointed time is great, until the great judgment comes upon them.'.", "reason": "previous_rendering"}]}}, {"reference": "1 Enoch 22:5", "source": {"edition": "charles-1906-enoch", "text": "ርኢኩ፡ *መናፍስተ፡ ውሉደ፡ ሰብእ፡ እንዘ፡ ሙታን፡ ውእቶሙ፡ ወቃሎሙ፡ ይበጽሕ፡ እስከ፡ ሰማይ፡ ወይስኪ።", "language": "Geez", "pages": [94], "confidence": "medium", "validation": "unapplied_full_printed_unit_candidate", "note": "Recovered from sources/enoch/ethiopic/transcribed/charles_1906/ch22.txt via tools/enoch/verse_parser.py | Dillmann 1851 chapter OCR exists for chapter 22, but verse-aligned extraction is not yet implemented in this prompt builder."}, "translation": {"text": "And I saw the spirits of the children of men who were dead[b][a], and their voice reached to heaven and cried out.", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "Or 'their cry reached to heaven and complained.' The final verb is difficult and may denote complaint or accusation rather than a neutral utterance.", "reason": "lexical_alternative"}, {"marker": "b", "text": "Or 'made accusation'.", "reason": "previous_rendering"}]}}, {"reference": "1 Enoch 22:6", "source": {"edition": "charles-1906-enoch", "text": "ውእቱ፡ ጊዜ፡ ተስእልክዎ፡ ለሩፋኤል፡ መልአክ፡ እንዘ፡ ሀሎ፡ ምስሌየ፡ ወእቤሎ፡ ዝመንፈስ፡ ዘመኑ፡ ውእቱ፡ ዘከመዝ፡ ቃሉ፡ ይበጽሕ፡ ወይሰኪ።", "language": "Geez", "pages": [94, 96], "confidence": "medium", "validation": "unapplied_full_printed_unit_candidate", "note": "Recovered from sources/enoch/ethiopic/transcribed/charles_1906/ch22.txt via tools/enoch/verse_parser.py | Dillmann 1851 chapter OCR exists for chapter 22, but verse-aligned extraction is not yet implemented in this prompt builder."}, "translation": {"text": "At that time I asked Raphael[a], the angel who was with me, and I said to him[c][b], “This spirit whose voice reaches thus and accuses—to whom does it belong?”", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "Or 'whose voice reaches like this and entreats.' The final verb is difficult and may denote supplication or urgent appeal.", "reason": "lexical_alternative"}, {"marker": "b", "text": "The question asks for the identity of the spirit whose cry is being heard; the next verse identifies it as the spirit of Abel.", "reason": "cross_reference"}, {"marker": "c", "text": "Or 'At that time I asked Raphael, the angel who was with me, and I said to him, “This spirit whose voice reaches thus and makes petition—whose is it?”'.", "reason": "previous_rendering"}]}}, {"reference": "1 Enoch 22:7", "source": {"edition": "charles-1906-enoch", "text": "ወአውሥአኒ፡ [ወይቤለኒ፡] እንዘ፡ ይብል፡ ዝንቱ፡ መንፈስ፡ ውእቱ፡ ዘ*ወጽአ፡ እምአቤል፡ ዘ*ቀተሎ፡ ቃየን፡ እኁሁ፡ ወይሰኪ፡ ኪያሁ፡ እስከ፡ ሶበ፡ ይትኀጐል፡ ዘርኡ፡ እምቅድመ፡ ገጸ፡ ለምድር፡ ወእምዘርአ፡ ሰብእ፡ ይማስን፡ ዘርኡ።", "language": "Geez", "pages": [96], "confidence": "medium", "validation": "unapplied_full_printed_unit_candidate", "note": "Recovered from sources/enoch/ethiopic/transcribed/charles_1906/ch22.txt via tools/enoch/verse_parser.py | Dillmann 1851 chapter OCR exists for chapter 22, but verse-aligned extraction is not yet implemented in this prompt builder."}, "translation": {"text": "And he answered me and said to me[a], “This is the spirit that came out from Abel, whom Qayin his brother killed; and it makes accusation against him until his seed is destroyed from before the face of the earth[d][c][b], and his seed is blotted out from among the seed of men.”", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "The speech formula includes both 'he answered me' and, in this witness, a bracketed 'and said to me.' The English keeps both to reflect the received wording.", "reason": "textual_variant"}, {"marker": "b", "text": "'Makes accusation against him' reflects a judicial sense: Abel's spirit functions as an accuser crying for judgment, not merely as a narrator of grievance.", "reason": "lexical_alternative"}, {"marker": "c", "text": "'Seed' is retained twice to preserve the lineage-focused judgment language; 'offspring' or 'descendants' would be smoother but less transparent to the repeated wording.", "reason": "lexical_alternative"}, {"marker": "d", "text": "Or 'And he answered me and said, while speaking:'.", "reason": "previous_rendering"}]}}, {"reference": "1 Enoch 22:8", "source": {"edition": "charles-1906-enoch", "text": "ውእተ፡ ጊዜ፡ ተስእልኩ፡ [በእንቲአሁ፡ ወ]በእንተ፡ ኵነኔ፡ ኵሉ፡ በእንተ፡ ምንት፡ ተፈልጡ፡ ፩እምነ፡ ፩።", "language": "Geez", "pages": [96], "confidence": "medium", "validation": "unapplied_full_printed_unit_candidate", "note": "Recovered from sources/enoch/ethiopic/transcribed/charles_1906/ch22.txt via tools/enoch/verse_parser.py | Dillmann 1851 chapter OCR exists for chapter 22, but verse-aligned extraction is not yet implemented in this prompt builder."}, "translation": {"text": "And at that time I asked concerning him and concerning the judgment of all: for what reason were they separated[c][b][a], one from another?", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "The phrase 'concerning them' reflects the transmitted Ge'ez, where the referent is the groups or places just described in the vision.", "reason": "cross_reference"}, {"marker": "b", "text": "The opening bracketed words in the OCR suggest minor uncertainty in the exact prepositional phrasing before 'concerning them,' but the sense of Enoch's inquiry is stable.", "reason": "textual_variant"}, {"marker": "c", "text": "Or 'concerning them'.", "reason": "previous_rendering"}]}}, {"reference": "1 Enoch 22:9", "source": {"edition": "charles-1906-enoch", "text": "*ወአውሥአኒ፡ ወይቤለኒ፡ እሉ፡ ፫ትገብሩ፡ ከመ፡ ይትፈለጠ፡ መንፈሶሙ፡ ለ*ምዉታን፡ ወከመዝ፡ ተፈልጠ፡ ለመንፈሶሙ፡ ለጻድቃን፡ ዘውእቱ፡ ነቅዐ፡ ማይ፡ በላዕሌሁ፡ ብርሃን፡።", "language": "Geez", "pages": [96], "confidence": "medium", "validation": "unapplied_full_printed_unit_candidate", "note": "Recovered from sources/enoch/ethiopic/transcribed/charles_1906/ch22.txt via tools/enoch/verse_parser.py | Dillmann 1851 chapter OCR exists for chapter 22, but verse-aligned extraction is not yet implemented in this prompt builder."}, "translation": {"text": "And he answered me and said to me[a], “These three have been made so that the spirits of the dead might be separated. And thus a division has been made for the spirits of the righteous, where there is a spring of water[e][d][c][b], with light above it.”", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "The Ge'ez repeats the separation language twice: first for 'the spirits of the dead' generally, then specifically for 'the spirits of the righteous.' The English preserves this repetition with 'separated' and 'division.'", "reason": "lexical_alternative"}, {"marker": "b", "text": "Or 'a fountain/source of water.' The image is a water-source within the place assigned to the righteous.", "reason": "lexical_alternative"}, {"marker": "c", "text": "The phrase 'above it light' is terse in the Ge'ez and may describe light resting over the spring or over the righteous division as a whole.", "reason": "alternative_reading"}, {"marker": "d", "text": "Or 'These three divisions were made'.", "reason": "previous_rendering"}, {"marker": "e", "text": "Or 'a division has been made'.", "reason": "previous_rendering"}]}}, {"reference": "1 Enoch 22:10", "source": {"edition": "charles-1906-enoch", "text": "በከመ፡ ከማሁ፡ ተፈጥረ፡ ለኃጥኣን፡ ሶበ፡ ይመውቱ፡ ወይትቀበሩ፡ ውስተ፡ ምድር፡ ወኵነኔ፡ ኢኮነ፡ በላዕሌሆሙ፡ በሕይወቶሙ።", "language": "Geez", "pages": [96], "confidence": "medium", "validation": "unapplied_full_printed_unit_candidate", "note": "Recovered from sources/enoch/ethiopic/transcribed/charles_1906/ch22.txt via tools/enoch/verse_parser.py | Dillmann 1851 chapter OCR exists for chapter 22, but verse-aligned extraction is not yet implemented in this prompt builder."}, "translation": {"text": "And so it was made for sinners[a], when they die and are buried in the earth[c][b], and judgment has not come upon them during their lifetime.", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "The opening 'And thus' likely refers back to the preceding description of separated places for the dead, indicating that this case corresponds to that arrangement.", "reason": "cross_reference"}, {"marker": "b", "text": "The passive verb 'has been made' could also be rendered 'has been appointed' or 'was created'; the text does not explicitly restate the noun supplied from the context.", "reason": "lexical_alternative"}, {"marker": "c", "text": "Or 'it has been made for sinners: when they die and are buried in the earth, and judgment has not come upon them'.", "reason": "previous_rendering"}]}}, {"reference": "1 Enoch 22:11", "source": {"edition": "charles-1906-enoch", "text": "በዝየ፡ ይትፈለጠ፡ ነፍሳቲሆሙ፡ ዲበ፡ ዛቲ፡ ዐቢይ፡ ጻዕር፡ እስከ፡ አመ፡ ዐቢይ፡ ዕለት፡ እንተ፡ ኵነኔ፡ ወመቅሠፍት፡ ወጻዕር፡ ለእለ፡ ይረግሙ፡ እስከ፡ ለዓለም፡ ወበቀል፡ ለነፍሶሙ፡ በህየ፡ ይእስሮሙ፡ እስከ፡ ለዓለም፡ [ወእመኒ፡ ውእቱ፡ እምቅድመ፡ ዓለም።]", "language": "Geez", "pages": [96], "confidence": "medium", "validation": "unapplied_full_printed_unit_candidate", "note": "Recovered from sources/enoch/ethiopic/transcribed/charles_1906/ch22.txt via tools/enoch/verse_parser.py | Dillmann 1851 chapter OCR exists for chapter 22, but verse-aligned extraction is not yet implemented in this prompt builder."}, "translation": {"text": "Here their souls are set apart in this great affliction until the great day of judgment and punishment and affliction for those who curse forever[a]; and vengeance on their souls[d][c][b]. There he will bind them[e] forever.", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "The phrase 'those who are cursed forever' may also be understood as 'those who curse forever' if the verb is taken actively, but the passive sense fits the judgment context better.", "reason": "lexical_alternative"}, {"marker": "b", "text": "A bracketed clause in the witness reads, 'and this [was] from before the world,' but the text is uncertain and is not included in the main translation.", "reason": "textual_variant"}, {"marker": "c", "text": "Or 'Thus'.", "reason": "previous_rendering"}, {"marker": "d", "text": "Or 'are cursed'.", "reason": "previous_rendering"}, {"marker": "e", "text": "Or 'and there he will exact vengeance for their souls. There he will bind them'.", "reason": "previous_rendering"}]}}, {"reference": "1 Enoch 22:12", "source": {"edition": "charles-1906-enoch", "text": "ወከመዝ፡ ተፈልጠ፡ ለነፍሰ፡ እለ፡ ይስክዩ፡ እለ፡ ያርእዩ፡ በእንተ፡ ሕጉለት፡ አመ፡ ተቀትሉ፡ በመዋዕለ፡ ኃጥኣን።", "language": "Geez", "pages": [96], "confidence": "medium", "validation": "unapplied_full_printed_unit_candidate", "note": "Recovered from sources/enoch/ethiopic/transcribed/charles_1906/ch22.txt via tools/enoch/verse_parser.py | Dillmann 1851 chapter OCR exists for chapter 22, but verse-aligned extraction is not yet implemented in this prompt builder."}, "translation": {"text": "And thus a division has been made for the souls of those who make their complaint[d][c][b][a], who make known their destruction when they were slain in the days of the sinners.", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "Or 'those who cry out' or 'those who bring accusation.' The Ge'ez verb can suggest lament, complaint, or protest.", "reason": "lexical_alternative"}, {"marker": "b", "text": "The phrase 'concerning their destruction' may refer specifically to the violent manner of their death rather than destruction in a broader sense.", "reason": "lexical_alternative"}, {"marker": "c", "text": "This verse continues the description of separated places for the dead in Sheol, where the slain await judgment and vindication.", "reason": "cross_reference"}, {"marker": "d", "text": "Or 'who reveal concerning their destruction'.", "reason": "previous_rendering"}]}}, {"reference": "1 Enoch 22:13", "source": {"edition": "charles-1906-enoch", "text": "ወከመዝ፡ ተፈጥረ፡ ለነፍሶሙ፡ ለሰብእ፡ እለ፡ ኢኮኑ፡ ጻድቃነ፡ አላ፡ ኃጥኣነ፡ እለ፡ ፍጹማነ፡ እበሳ፡ ወምስለ፡ አባሲያን፡ ይከውኑ፡ ከማሆሙ፡ ወነፍሶሙሰ፡ እትትቀተል፡ በዕለተ፡ ኵነኔ፡ ወኢ*ይትነሥኡ፡ *እምነ፡ ዝየ።", "language": "Geez", "pages": [96, 98], "confidence": "medium", "validation": "unapplied_full_printed_unit_candidate", "note": "Recovered from sources/enoch/ethiopic/transcribed/charles_1906/ch22.txt via tools/enoch/verse_parser.py | Dillmann 1851 chapter OCR exists for chapter 22, but verse-aligned extraction is not yet implemented in this prompt builder."}, "translation": {"text": "And thus it has been made for the souls of people who were not righteous, but sinners, who were complete in transgression; they will be with the lawless like them. But their souls will not be killed on the day of judgment, nor will they rise from here.[a]", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "The final killing and rising clauses, including their negatives, are provisional until the printed cross-page continuation and Charles’s notes are checked; this does not state a general doctrine about all souls or substitute chapter 21’s imprisoned angels.", "reason": "textual_uncertainty"}]}}, {"reference": "1 Enoch 22:14", "source": {"edition": "charles-1906-enoch", "text": "ውእተ፡ ጊዜ፡ ባረክዎ፡ ለ*እግዚአ፡ ስብሐት፡ ወእቤ፡ ቡሩክ፡ እግዚአየ፡ እግዚአ፡ ጽድቅ፡ ዘ'ይመልክ፡ እስከ፡ ለዓለም።", "pages": [98], "language": "Geez", "validation": "unapplied_full_printed_unit_candidate"}, "translation": {"text": "At that time I blessed the Lord of Glory and said, “Blessed is my Lord, the Lord of righteousness, who reigns forever.”[a]", "philosophy": "optimal-equivalence", "footnotes": [{"marker": "a", "text": "Rules is a possible rendering of the final reigns expression. The two titles and the final clause must be checked against the selected printed source; no further event is depicted.", "reason": "lexical_alternative"}]}}]
