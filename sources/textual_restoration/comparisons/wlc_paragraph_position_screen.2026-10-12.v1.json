  "interpretation": "Legacy Verse.hebrew_text joins all words then appends collected segments. Existing comparison parser retains XML child positions in annotations and excludes paragraph letters from written_stream while retaining genuine word letters. Schema's 'verbatim' description is not proof of diplomatic positioning. No ancient variant follows from this rendering defect.",
  "enabling_action": "Small regression tests for actual 1Chr12:14 and synthetic pe/samekh ordering using existing comparison parser. No parser/default/canonical migration or whole-corpus provenance rerun.",
  "query_implementation": "from pathlib import Path\nimport json, hashlib, collections, xml.etree.ElementTree as ET\nfrom tools.wlc import OT_BOOKS, OSIS_NS, load_verse\nROOT = Path(\".\")\nout = []\npins = {}\ntotal = 0\nmarker_total = collections.Counter()\ninternal_total = collections.Counter()\nbooks = {}\ndef local(e):\n    return e.tag.rsplit(\"}\", 1)[-1]\nfor code, (osis, slug, title, name) in OT_BOOKS.items():\n    p = ROOT / \"sources/ot/wlc\" / name\n    raw = p.read_bytes()\n    pins[str(p)] = hashlib.sha256(raw).hexdigest()\n    r = ET.fromstring(raw)\n    b = []\n    for v in r.findall(\".//o:verse\", OSIS_NS):\n        total += 1\n        children = list(v)\n        markers = []\n        w_before = 0\n        for i, c in enumerate(children):\n            if local(c) == \"w\":\n                w_before += 1\n            if local(c) == \"seg\" and c.get(\"type\") in {\"x-samekh\", \"x-pe\"}:\n                typ = c.get(\"type\")\n                marker_total[typ] += 1\n                later = [x for x in children[i + 1:] if local(x) == \"w\"]\n                if later:\n                    internal_total[typ] += 1\n                    markers.append({\"type\": typ, \"direct_child_index\": i,\n                                    \"words_before\": w_before, \"words_after\": len(later),\n                                    \"text\": c.text})\n        if markers:\n            row = {\"osis_id\": v.get(\"osisID\"), \"markers\": markers}\n            out.append(row)\n            b.append(row)\n    books[code] = {\"affected_verse_contexts\": len(b),\n                   \"internal_markers\": sum(len(v[\"markers\"]) for v in b)}\nx = ET.parse(ROOT / \"sources/ot/wlc/1Chr.xml\").getroot().find(\n    \".//o:verse[@osisID='1Chr.12.14']\", OSIS_NS)\nyaml_path = ROOT / \"translation/ot/1_chronicles/012/014.yaml\"\nprint(json.dumps({\n    \"books_scanned\": len(pins), \"verse_contexts_scanned\": total,\n    \"direct_paragraph_markers_total\": dict(marker_total),\n    \"internal_paragraph_markers\": dict(internal_total),\n    \"affected_verse_contexts\": len(out), \"by_book\": books, \"contexts\": out,\n    \"xml_pin_map_sha256_sorted_json\": hashlib.sha256(\n        json.dumps(pins, sort_keys=True, separators=(\",\", \":\")).encode()).hexdigest(),\n    \"xml_pins\": pins,\n    \"target_xml\": ET.tostring(x, encoding=\"unicode\"),\n    \"target_legacy_rendering\": load_verse(\"1CH\", 12, 14, ROOT / \"sources\").hebrew_text,\n    \"target_yaml_sha256_at_observation\": hashlib.sha256(yaml_path.read_bytes()).hexdigest(),\n    \"parser_sha256\": {str(p): hashlib.sha256(p.read_bytes()).hexdigest()\n        for p in [Path(\"tools/wlc.py\"),\n                  Path(\"tools/textual_restoration/compare_uxlc_wlc.py\")]},\n}, ensure_ascii=False, indent=2))\n",
