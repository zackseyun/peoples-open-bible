  "evidence": {
    "hebrew_construction": "Pregnancy adjective plus feminine singular Qal active birth participle; no tensed copula",
    "grammar": {
      "GKC80d": "Contracted birth participle in Genesis16:11/Judges13:5,7; different surface form from Isaiah",
      "GKC116admnp": "Participle time comes from context; present and prospective uses both available; Genesis16:11 is a present-state example",
      "GKC141bf": "Adjective/participle predicates can lack a copula; contextual time"
    },
    "present_countercase": "Pregnancy adjective, deictic presentation and Genesis analogy support a present state; the child-development deadline permits it",
    "prospective_countercase": "A promised sign and subsequent child-development/political events allow prospective interpretation; Judges supplies an announcement context, without narrating intervening conception",
    "genesis_context": "Genesis16:4 explicitly narrates conception before 16:11; it cannot automatically fix Isaiah chronology",
