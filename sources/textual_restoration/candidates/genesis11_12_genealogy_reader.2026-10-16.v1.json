      "chosen": "And Arpachshad",
      "alternatives": [
        "Now Arpachshad",
        "Arpachshad"
      ],
      "lexicon": "HALOT",
      "rationale": "The conjunction וְ is retained as 'And' to preserve the genealogical sequence and narrative linkage. The proper name is transliterated, following the philosophy of transliterating personal names rather than translating them."
    },
    {
      "source_word": "חַי",
      "chosen": "lived",
      "alternatives": [
